{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protonvpn-next",
  "compatibility_date": "2026-04-02",
  "observability": {
    "enabled": true
  },
  // Vite writes the built site to `dist`; `public/` is copied into it untouched.
  "assets": {
    "directory": "dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
