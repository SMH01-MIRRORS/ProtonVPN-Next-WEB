{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --unstable-kv server.ts",
    "start:container": "deno run --allow-net --allow-read --allow-env --allow-write=/deno-dir --unstable-kv server.ts",
    "proxy": "deno run --allow-net proxy/deno/main.ts"
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
